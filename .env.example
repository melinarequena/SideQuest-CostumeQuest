# Copiar a .env.local y completar con el proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# false para conectar Supabase. true habilita la demo local explícita.
NEXT_PUBLIC_DEMO_MODE=true
# URL pública definitiva para generar el QR. En local se usa la URL del navegador.
NEXT_PUBLIC_SITE_URL=
